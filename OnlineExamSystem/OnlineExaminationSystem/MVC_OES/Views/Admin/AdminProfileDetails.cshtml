@model MVC_OES.Models.Profile.AdminProfileDto

@{
    ViewBag.Title = "Admin Profile";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="card shadow-lg p-4" style="max-width: 600px; margin: auto;">
        <h3 class="text-center mb-4 text-primary">
            <i class="fas fa-user-shield"></i> Admin Profile
        </h3>

        <table class="table table-striped table-bordered">
            <tr>
                <th>Name</th>
                <td>@Model.AdminName</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>@Model.Phone</td>
            </tr>
            <tr>
                <th>Address</th>
                <td>@Model.Address</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@Model.Email</td>
            </tr>
        </table>

        <div class="text-center mt-3">
            <a href="@Url.Action("Dashboard", "Admin", new { id = Session["UserId"] })" class="btn btn-secondary">
                ← Back to Dashboard
            </a>
        </div>
    </div>
</div>

<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
