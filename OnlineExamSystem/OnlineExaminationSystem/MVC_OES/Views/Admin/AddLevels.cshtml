@model List<MVC_OES.Models.Levels.LevelViewModel>
@{
    ViewBag.Title = "Add Levels";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5f7fa;
    }

    .level-card {
        border-radius: 12px;
        padding: 20px;
        background: #fff;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .level-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        .level-card h4 {
            color: #007bff;
            margin-bottom: 15px;
            font-weight: 700;
        }

    .btn-submit {
        width: 100%;
        margin-top: 15px;
    }

    label {
        font-weight: 500;
    }
</style>

<div class="container mt-4">
    <h2 class="text-center mb-4 fw-bold"><i class="fas fa-layer-group"></i> Add Levels</h2>

    <form method="post" action="@Url.Action("AddLevels", "Admin", new { courseId = ViewBag.CourseId })">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="level-card">
                <h4>Level @Model[i].LevelNumber</h4>
                <input type="hidden" name="[@i].LevelNumber" value="@Model[i].LevelNumber" />

                <div class="mb-3">
                    <label>Level Name</label>
                    <input type="text" name="[@i].LevelName" class="form-control" placeholder="Enter level name" required />
                </div>

                <div class="mb-3">
                    <label>Duration (mins)</label>
                    <input type="number" name="[@i].Duration" class="form-control" value="5" min="1" required />
                </div>

                <div class="mb-3">
                    <label>Passing Marks</label>
                    <input type="number" name="[@i].PassingMarks" class="form-control" value="20" min="1" required />
                </div>

                <div class="mb-3">
                    <label>Total Questions</label>
                    <input type="number" name="[@i].TotalQuestions" class="form-control" min="1" required />
                </div>
            </div>
        }

        <button type="submit" class="btn btn-success btn-submit">
            <i class="fas fa-save"></i> Save All Levels
        </button>
    </form>

    <div class="text-center mt-3">
        <a href="@Url.Action("Levels", "Admin", new { courseId = ViewBag.CourseId })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Levels
        </a>
    </div>
</div>
