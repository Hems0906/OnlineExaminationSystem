@model MVC_OES.Models.Courses.AddCourseModel
@{
    ViewBag.Title = "Add Course";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5f7fa;
    }

    .form-container {
        max-width: 500px;
        margin: 50px auto;
        padding: 30px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }

    h2 {
        color: #007bff;
        text-align: center;
        margin-bottom: 25px;
        font-weight: 700;
    }

    .btn-primary {
        width: 100%;
    }
</style>

<div class="form-container">
    <h2><i class="fas fa-plus-circle"></i> Add New Course</h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    @using (Html.BeginForm("AddCourse", "Admin", FormMethod.Post))
    {
        <div class="mb-3">
            @Html.LabelFor(m => m.CourseName, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.CourseName, new { @class = "form-control", placeholder = "Enter course name" })
            @Html.ValidationMessageFor(m => m.CourseName, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Course
        </button>
    }

    <a href="@Url.Action("Courses", "Admin")" class="btn btn-secondary mt-3">
        <i class="fas fa-arrow-left"></i> Back to Courses
    </a>
</div>
