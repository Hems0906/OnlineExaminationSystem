@model List<MVC_OES.Models.Questions.ExamAttemptViewModel>

@{
    ViewBag.Title = "Exam Attempts";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #eef2f7;
        font-family: 'Segoe UI', sans-serif;
    }

    .attempts-container {
        padding: 50px 0;
        position: relative;
    }

    .attempts-card {
        background: #fff;
        border-radius: 1rem;
        padding: 30px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.1);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .attempts-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 40px rgba(0,0,0,0.15);
        }

        .attempts-card h2 {
            color: #0d6efd;
            font-weight: 700;
            margin-bottom: 30px;
            text-align: center;
        }

    .back-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #0d6efd;
        color: #fff;
        border-radius: 50px;
        padding: 10px 20px;
        font-weight: 600;
        transition: 0.3s;
    }

        .back-btn:hover {
            background: #0b5ed7;
            text-decoration: none;
        }

    .table thead {
        background: linear-gradient(90deg, #0d6efd, #6610f2);
        color: #fff;
        font-weight: 600;
    }

    .table tbody tr:hover {
        background-color: #f0f4ff;
    }

    .table td, .table th {
        vertical-align: middle;
        text-align: center;
    }

    .badge-pass {
        background-color: #28a745;
        color: #fff;
        font-weight: 500;
    }

    .badge-fail {
        background-color: #dc3545;
        color: #fff;
        font-weight: 500;
    }

    .form-select {
        max-width: 300px;
        margin-bottom: 20px;
    }
</style>

<div class="container attempts-container">
    <div class="attempts-card mx-auto">
        <h2>Exam Attempts</h2>

        <a href="@Url.Action("Dashboard", "Admin")" class="back-btn">
            <i class="fas fa-arrow-left"></i> Dashboard
        </a>

        <form method="get" action="@Url.Action("ExamAttempts", "Admin")" class="mb-3">
            <div class="d-flex justify-content-start">
                <select class="form-select" name="studentId" onchange="this.form.submit()">
                    <option value="">All Students</option>
                    @foreach (var student in ViewBag.StudentList as List<SelectListItem>)
                    {
                        <option value="@student.Value" @(student.Value == Convert.ToString(ViewBag.SelectedStudent) ? "selected" : "")>
                            @student.Text
                        </option>
                    }
                </select>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Email</th>
                        <th>Course</th>
                        <th>Level</th>
                        <th>Total Questions</th>
                        <th>Correct Answers</th>
                        <th>Score</th>
                        <th>Result</th>
                        <th>Time Taken</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var attempt in Model)
                        {
                            <tr>
                                <td>@attempt.StudentName</td>
                                <td>@attempt.Email</td>
                                <td>@attempt.CourseName</td>
                                <td>@attempt.LevelNumber</td>
                                <td>@attempt.TotalQuestions</td>
                                <td>@attempt.CorrectAnswers</td>
                                <td>@attempt.Score</td>
                                <td>
                                    @if (attempt.IsPassed)
                                    {
                                        <span class="badge badge-pass">Passed</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-fail">Failed</span>
                                    }
                                </td>
                                <td>@attempt.TimeTaken / @attempt.TotalTime mins</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted">No records found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
