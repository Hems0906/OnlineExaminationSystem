@model MVC_OES.Models.Levels.LevelViewModel
@{
    ViewBag.Title = "Edit Level";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5f7fa;
    }

    .edit-card {
        max-width: 600px;
        margin: 40px auto;
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .edit-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        .edit-card h2 {
            color: #007bff;
            margin-bottom: 20px;
            font-weight: 700;
            text-align: center;
        }

    .btn-submit {
        width: 100%;
        margin-top: 15px;
    }

    label {
        font-weight: 500;
    }
</style>

<div class="edit-card">
    <h2><i class="fas fa-edit"></i> Edit Level - @Model.LevelName</h2>

    @using (Html.BeginForm())
    {
        @Html.HiddenFor(m => m.CourseId)
        @Html.HiddenFor(m => m.LevelNumber)

        <div class="mb-3">
            @Html.LabelFor(m => m.LevelName)
            @Html.TextBoxFor(m => m.LevelName, new { @class = "form-control", placeholder = "Enter level name" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Duration)
            @Html.TextBoxFor(m => m.Duration, new { @class = "form-control", type = "number", min = "1" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.PassingMarks)
            @Html.TextBoxFor(m => m.PassingMarks, new { @class = "form-control", type = "number", min = "1" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.TotalQuestions)
            @Html.TextBoxFor(m => m.TotalQuestions, new { @class = "form-control", type = "number", min = "1" })
        </div>

        <button type="submit" class="btn btn-success btn-submit">
            <i class="fas fa-save"></i> Save Changes
        </button>
    }

    <div class="text-center mt-3">
        <a href="@Url.Action("Levels", "Admin", new { courseId = Model.CourseId })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Cancel
        </a>
    </div>
</div>
