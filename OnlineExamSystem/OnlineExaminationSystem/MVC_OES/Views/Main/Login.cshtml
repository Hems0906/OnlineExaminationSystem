@model MVC_OES.Models.Home.StudentLogin
@{
    ViewBag.Title = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f5f7fa;
    }

    .login-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    }

        .login-card h2 {
            font-weight: bold;
            color: #007bff;
            text-align: center;
        }

    .form-control {
        padding-left: 40px;
    }

    .input-icon {
        position: absolute;
        top: 11px;
        left: 12px;
        color: #6c757d;
    }

    .form-group {
        position: relative;
        margin-bottom: 18px;
    }

    .btn-login {
        background-color: #007bff;
        color: #fff;
        width: 100%;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-login:hover {
            background-color: #0056b3;
        }

    .forgot-link {
        text-align: right;
        display: block;
        margin-top: -5px;
        margin-bottom: 15px;
    }

        .forgot-link a {
            color: #007bff;
            font-size: 0.9rem;
            text-decoration: none;
        }

            .forgot-link a:hover {
                text-decoration: underline;
            }

    .register-link {
        text-align: center;
        margin-top: 15px;
        font-size: 0.95rem;
    }

        .register-link a {
            color: #007bff;
            text-decoration: none;
            font-weight: bold;
        }

            .register-link a:hover {
                text-decoration: underline;
            }
</style>

<div class="login-container">
    <div class="login-card">
        <h2>Login</h2>
        <p class="text-center text-muted mb-4">Welcome back! Please login to continue.</p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        @using (Html.BeginForm("Login", "Main", FormMethod.Post))
        {
            <div class="form-group">
                <i class="fas fa-envelope input-icon"></i>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Enter your email" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <i class="fas fa-lock input-icon"></i>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="forgot-link">
                <a href="@Url.Action("ForgotPassword", "Main")">Forgot Password?</a>
            </div>

            <button type="submit" class="btn btn-login btn-lg">
                <i class="fas fa-sign-in-alt"></i> Login
            </button>
        }

        <div class="register-link">
            <p>Don't have an account? <a href="@Url.Action("Register", "Main")">Register Here</a></p>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("form").removeData("validator");
            $("form").removeData("unobtrusiveValidation");
            $.validator.unobtrusive.parse("form");

            $("#Email, #Password").on("input", function () {
                $(this).valid();
            });

            var btn = $("#btnLogin");
            function checkFormValidity() {
                if ($("#loginForm").valid()) {
                    btn.prop("disabled", false).css("opacity", "1");
                } else {
                    btn.prop("disabled", true).css("opacity", "0.5");
                }
            }

            $("#loginForm input").on("input", checkFormValidity);
            checkFormValidity();
        });
    </script>
}