@{
    ViewBag.Title = "Forgot Password";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f5f7fa;
    }

    .forgot-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    }

        .forgot-card h2 {
            font-weight: bold;
            color: #007bff;
            text-align: center;
        }

        .forgot-card p {
            text-align: center;
            color: #6c757d;
            margin-bottom: 20px;
        }

    .form-control {
        padding-left: 40px;
    }

    .input-icon {
        position: absolute;
        top: 11px;
        left: 12px;
        color: #6c757d;
    }

    .form-group {
        position: relative;
        margin-bottom: 18px;
    }

    .btn-forgot {
        background-color: #007bff;
        color: #fff;
        width: 100%;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-forgot:hover {
            background-color: #0056b3;
        }

    .back-to-login {
        text-align: center;
        margin-top: 15px;
        font-size: 0.95rem;
    }

        .back-to-login a {
            color: #007bff;
            text-decoration: none;
            font-weight: bold;
        }

            .back-to-login a:hover {
                text-decoration: underline;
            }
</style>

<div class="forgot-container">
    <div class="forgot-card">
        <h2>Forgot Password</h2>
        <p>Enter your email to reset your password</p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        @using (Html.BeginForm("ForgotPassword", "Main", FormMethod.Post, new { id = "forgotForm" }))
        {
            <div class="form-group">
                <i class="fas fa-envelope input-icon"></i>
                <input type="email" name="email" id="Email" class="form-control" placeholder="Enter your email" required />
                <span class="text-danger field-validation-valid" data-valmsg-for="email" data-valmsg-replace="true"></span>
            </div>

            <button type="submit" class="btn btn-forgot btn-lg">
                <i class="fas fa-paper-plane"></i> Send OTP
            </button>
        }

        <div class="back-to-login">
            <p><a href="@Url.Action("Login", "Main")"><i class="fas fa-arrow-left"></i> Back to Login</a></p>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("form").removeData("validator");
            $("form").removeData("unobtrusiveValidation");
            $.validator.unobtrusive.parse("form");

            $("#Email").on("input", function () {
                $(this).valid();
            });

            var btn = $(".btn-forgot");
            function checkFormValidity() {
                if ($("#forgotForm").valid()) {
                    btn.prop("disabled", false).css("opacity", "1");
                } else {
                    btn.prop("disabled", true).css("opacity", "0.5");
                }
            }

            $("#forgotForm input").on("input", checkFormValidity);
            checkFormValidity();
        });
    </script>
}
