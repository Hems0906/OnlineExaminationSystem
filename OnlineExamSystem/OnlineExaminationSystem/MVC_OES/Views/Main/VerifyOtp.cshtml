@{
    ViewBag.Title = "Verify OTP";
}

<!-- Bootstrap & FontAwesome -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f5f7fa;
    }

    .otp-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .otp-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    }

        .otp-card h2 {
            font-weight: bold;
            color: #007bff;
            text-align: center;
        }

        .otp-card p {
            text-align: center;
            color: #6c757d;
            margin-bottom: 20px;
        }

    .form-control {
        padding-left: 40px;
        font-weight: bold;
        letter-spacing: 3px;
        text-align: center;
    }

    .input-icon {
        position: absolute;
        top: 11px;
        left: 12px;
        color: #6c757d;
    }

    .form-group {
        position: relative;
        margin-bottom: 18px;
    }

    .btn-verify {
        background-color: #007bff;
        color: #fff;
        width: 100%;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-verify:hover {
            background-color: #0056b3;
        }

    .resend-link {
        text-align: center;
        margin-top: 15px;
        font-size: 0.95rem;
    }

        .resend-link a {
            color: #007bff;
            text-decoration: none;
            font-weight: bold;
        }

            .resend-link a:hover {
                text-decoration: underline;
            }
</style>

<div class="otp-container">
    <div class="otp-card">
        <h2>Verify OTP</h2>
        <p>Enter the 6-digit OTP sent to your email</p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        @using (Html.BeginForm("VerifyOtp", "Main", FormMethod.Post, new { id = "otpForm" }))
        {
            <div class="form-group">
                <i class="fas fa-key input-icon"></i>
                <input type="text" name="otp" id="Otp" maxlength="6" class="form-control" placeholder="Enter OTP" required />
                <span class="text-danger field-validation-valid" data-valmsg-for="otp" data-valmsg-replace="true"></span>
            </div>

            <button type="submit" class="btn btn-verify btn-lg">
                <i class="fas fa-check-circle"></i> Verify OTP
            </button>
        }

        <div class="resend-link">
            <p>Didn't receive OTP? <a href="@Url.Action("ResendOtp", "Main")">Resend</a></p>
        </div>
    </div>
</div>

<!-- jQuery + Validation -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("form").removeData("validator");
            $("form").removeData("unobtrusiveValidation");
            $.validator.unobtrusive.parse("form");

            // Allow only numbers in OTP field
            $("#Otp").on("input", function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });

            // Disable button until OTP is valid
            var btn = $(".btn-verify");
            function checkOtpValidity() {
                if ($("#Otp").val().length === 6) {
                    btn.prop("disabled", false).css("opacity", "1");
                } else {
                    btn.prop("disabled", true).css("opacity", "0.5");
                }
            }

            $("#Otp").on("input", checkOtpValidity);
            checkOtpValidity();
        });
    </script>
}
