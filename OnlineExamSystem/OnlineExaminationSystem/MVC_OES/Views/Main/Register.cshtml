@model MVC_OES.Models.Home.StudentRegister
@{
    ViewBag.Title = "Register";
}

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

        <style>
            body {
                background-color: #f5f7fa;
            }

            .register-container {
                min-height: 90vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .register-card {
                width: 100%;
                max-width: 650px;
                background: #fff;
                padding: 30px;
                border-radius: 12px;
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
            }

                .register-card h2 {
                    text-align: center;
                    color: #007bff;
                    font-weight: bold;
                    margin-bottom: 15px;
                }

            .form-control {
                padding-left: 40px;
            }

            .input-icon {
                position: absolute;
                top: 10px;
                left: 12px;
                color: #6c757d;
            }

            .form-group {
                position: relative;
                margin-bottom: 18px;
            }

            .btn-register {
                background-color: #007bff;
                color: #fff;
                font-weight: bold;
                width: 100%;
                padding: 10px;
                border-radius: 6px;
                transition: 0.3s;
            }

                .btn-register:hover {
                    background-color: #0056b3;
                }

            .login-link {
                text-align: center;
                margin-top: 15px;
                font-size: 0.95rem;
            }

                .login-link a {
                    color: #007bff;
                    font-weight: bold;
                    text-decoration: none;
                }

                    .login-link a:hover {
                        text-decoration: underline;
                    }
        </style>

        <div class="register-container">
            <div class="register-card">
                <h2>Student Registration</h2>
                <p class="text-center text-muted mb-3">Create your account to start your exams</p>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }

                @using (Html.BeginForm("Register", "Main", FormMethod.Post))
                {

                    <div class="form-group">
                        <i class="fas fa-user input-icon"></i>
                        @Html.TextBoxFor(m => m.StuName, new
                        {
                            @class = "form-control",
                            placeholder = "Enter your full name",
                            maxlength = "100",
                            oninput = "this.value = this.value.replace(/[^a-zA-Z\\s]/g, '')"
                        })
                        @Html.ValidationMessageFor(m => m.StuName, "", new { @class = "text-danger" })
                    </div>


                    <div class="form-group">
                        <i class="fas fa-phone input-icon"></i>
                        @Html.TextBoxFor(m => m.Mobile, new
                        {
                            @class = "form-control",
                            placeholder = "Enter your mobile number",
                            maxlength = "10",
                            oninput = "this.value = this.value.replace(/[^0-9]/g, '')"
                        })
                        @Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <i class="fas fa-city input-icon"></i>
                        @Html.TextBoxFor(m => m.City, new
                        {
                            @class = "form-control",
                            placeholder = "Enter your city",
                            maxlength = "50",
                            oninput = "this.value = this.value.replace(/[^a-zA-Z\\s]/g, '')"
                        })
                        @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <i class="fas fa-map-marker-alt input-icon"></i>
                        @Html.TextBoxFor(m => m.State, new
                        {
                            @class = "form-control",
                            placeholder = "Enter your state",
                            maxlength = "50",
                            oninput = "this.value = this.value.replace(/[^a-zA-Z\\s]/g, '')"
                        })
                        @Html.ValidationMessageFor(m => m.State, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <i class="fas fa-calendar input-icon"></i>
                        @Html.TextBoxFor(m => m.DOB, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.DOB, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <i class="fas fa-graduation-cap input-icon"></i>
                        @Html.TextBoxFor(m => m.Qualification, new { @class = "form-control", placeholder = "Enter your qualification" })
                        @Html.ValidationMessageFor(m => m.Qualification, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <i class="fas fa-calendar-check input-icon"></i>
                        @Html.TextBoxFor(m => m.Completion, new { @class = "form-control", placeholder = "Enter completion year" })
                        @Html.ValidationMessageFor(m => m.Completion, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <i class="fas fa-envelope input-icon"></i>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Enter your email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <i class="fas fa-lock input-icon"></i>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <i class="fas fa-lock input-icon"></i>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm password" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @*<label>Enter Captcha</label>*@
                        <div style="font-weight:bold; font-size:20px; background:#f0f0f0; padding:10px; display:inline-block;">
                            @ViewBag.CaptchaCode
                        </div>

                        @Html.TextBoxFor(m => m.CaptchaInput, new { @class = "form-control", placeholder = "Enter captcha here" })
                        @Html.ValidationMessageFor(m => m.CaptchaInput)
                    </div>

                    <button type="submit" class="btn btn-register btn-lg">
                        <i class="fas fa-user-plus"></i> Register
                    </button>
                }

                <div class="login-link">
                    <p>Already have an account? <a href="@Url.Action("Login", "Main")">Login Here</a></p>
                </div>
            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>


        @section Scripts {
            <script>
                $(document).ready(function () {
                    let inputs = $(".form-group input");
                    let btn = $(".btn-register");

                    inputs.prop("disabled", true).css("background-color", "#f5f5f5");
                    inputs.first().prop("disabled", false).css("background-color", "");

                    btn.prop("disabled", true).css("opacity", "0.5");

                    function validateInputs() {
                        let allFilled = true;
                        inputs.each(function () {
                            if ($(this).val().trim() === "") {
                                allFilled = false;
                                return false;
                            }
                        });

                        if (allFilled) {
                            btn.prop("disabled", false).css("opacity", "1");
                        } else {
                            btn.prop("disabled", true).css("opacity", "0.5");
                        }
                    }

                    inputs.on("input", function () {
                        let currentIndex = inputs.index(this);

                        if ($(this).val().trim() !== "") {
                            if (currentIndex + 1 < inputs.length) {
                                inputs.eq(currentIndex + 1).prop("disabled", false).css("background-color", "");
                            }
                        }

                        validateInputs();
                    });

                    validateInputs();
                });
            </script>

            <script>
                $(document).ready(function () {
                    $("form").removeData("validator");
                    $("form").removeData("unobtrusiveValidation");
                    $.validator.unobtrusive.parse("form");


                    $("form input").on("input", function () {
                        $(this).valid();
                    });
                });
            </script>

            <script>
                $(document).ready(function () {
                    $("#City, #State").on("keypress", function (e) {
                        let char = String.fromCharCode(e.which);
                        if (!/^[a-zA-Z\s]$/.test(char)) {
                            e.preventDefault();
                        }
                    });
                });
            </script>


        }