@model IEnumerable<MVC_OES.Models.Student.ExamResultViewModel>

@{
    ViewBag.Title = "Exam Results";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="text-end mb-3">
        <a href="@Url.Action("Dashboard", "Student", new { userId = (int)Session["UserId"]})" class="btn btn-primary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="fa-solid fa-chart-line"></i> Exam Results
        </h2>
        <p class="text-muted">Here’s a summary of your completed exams</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">
            <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Error
        </div>
    }
    else if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-lg rounded-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary text-center">
                    <tr>
                        <th><i class="fa-solid fa-book"></i> Course</th>
                        <th><i class="fa-solid fa-layer-group"></i> Level</th>
                        <th><i class="fa-solid fa-list-ol"></i> Total Marks</th>
                        <th><i class="fa-solid fa-flag-checkered"></i> Passing Marks</th>
                        <th><i class="fa-solid fa-star"></i> Score</th>
                        <th><i class="fa-solid fa-trophy"></i> Result</th>
                        <th><i class="fa-solid fa-clock"></i> Total Time<br /><small>(in mins)</small></th>
                        <th><i class="fa-solid fa-hourglass-half"></i> Time Taken<br /><small>(in mins)</small></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isPassed = item.Result.ToLower() == "pass";
                        <tr class="text-center">
                            <td class="fw-semibold">@item.Course</td>
                            <td>
                                <span class="badge bg-secondary px-3 py-2">
                                    Level @item.Level
                                </span>
                            </td>
                            <td>@item.TotalMarks</td>
                            <td>@item.PassingMarks</td>
                            <td class="fw-bold text-primary">@item.Score</td>
                            <td>
                                @if (isPassed)
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        <i class="fa-solid fa-circle-check"></i> Passed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2">
                                        <i class="fa-solid fa-circle-xmark"></i> Failed
                                    </span>
                                }
                            </td>
                            <td>@item.TotalTime</td>
                            <td>@item.TimeTaken</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-4 shadow-sm">
            <i class="fa-solid fa-info-circle"></i> No exam results found.
        </div>
    }
</div>

<style>
    .table {
        background-color: #fff;
        border-radius: 12px;
        overflow: hidden;
    }

        .table th {
            font-weight: bold;
            font-size: 1rem;
        }

        .table td {
            vertical-align: middle;
            font-size: 0.95rem;
        }

    .badge {
        font-size: 0.85rem;
        border-radius: 8px;
    }

    .table-hover tbody tr:hover {
        background-color: #f6f9ff;
        transform: scale(1.01);
        transition: all 0.2s ease-in-out;
    }
</style>
