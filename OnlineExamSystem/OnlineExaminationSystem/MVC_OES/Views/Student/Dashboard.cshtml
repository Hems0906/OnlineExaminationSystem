@{
        ViewBag.Title = "Dashboard";
        int userId = (int)Session["UserId"];
    }

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .dashboard-bg {
            background-image: url('@Url.Content("~/Image/Dashboard.jpg")');
            background-size: cover; 
            background-position: center; 
            background-repeat: no-repeat; 
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.7);
            text-align: center;
            padding: 20px;
        }

        .dashboard-buttons .btn {
            min-width: 180px;
            font-size: 1.1rem;
            padding: 12px 20px;
            margin: 10px;
            transition: transform 0.2s;
        }

            .dashboard-buttons .btn:hover {
                transform: scale(1.05);
            }

        h2 {
            margin-bottom: 20px;
        }
    </style>

    <div class="dashboard-bg text-center">
        <h2>Welcome, @Session["UserEmail"]! 👋</h2>

        <div class="dashboard-buttons mt-4">
            <a href="@Url.Action("Courses", "Student", new { userId = userId })" class="btn btn-primary">
                View Courses
            </a>
            <a href="@Url.Action("Reports", "Student", new { userId = userId })" class="btn btn-primary">
                View Reports
            </a>
        </div>
    </div>



