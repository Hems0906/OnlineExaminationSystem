@{
    ViewBag.Title = "Student Dashboard";
    var stats = ViewBag.Stats;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5f7fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dashboard-header {
        margin-bottom: 20px;
    }

    .dashboard-card {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        transition: 0.3s;
    }

        .dashboard-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        }

        .dashboard-card i {
            font-size: 2rem;
            color: #007bff;
            margin-bottom: 10px;
        }

    .quick-links .btn {
        width: 100%;
        margin-bottom: 10px;
    }
</style>

<div class="container mt-4">
    <div class="dashboard-header">
        <h2 class="fw-bold">Student Dashboard</h2>
        <p>Welcome, <strong>@ViewBag.UserEmail</strong> 👋</p>
    </div>

    @if (stats != null)
    {
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="dashboard-card text-center">
                    <i class="fas fa-book"></i>
                    <h5>Total Courses</h5>
                    <h3>@stats.TotalCourses</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dashboard-card text-center">
                    <i class="fas fa-check-circle"></i>
                    <h5>Completed Courses</h5>
                    <h3>@stats.CompletedCourses</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dashboard-card text-center">
                    <i class="fas fa-spinner"></i>
                    <h5>Ongoing Courses</h5>
                    <h3>@stats.OngoingCourses</h3>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="dashboard-card text-center">
                    <i class="fas fa-file-alt"></i>
                    <h5>Total Exams Attempted</h5>
                    <h3>@stats.TotalExamsAttempted</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dashboard-card text-center">
                    <i class="fas fa-trophy"></i>
                    <h5>Passed Exams</h5>
                    <h3>@stats.PassedExams</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dashboard-card text-center">
                    <i class="fas fa-percentage"></i>
                    <h5>Pass Percentage</h5>
                    <h3>@stats.PassPercentage%</h3>
                </div>
            </div>
        </div>
    }
    else
    {
        <p class="text-danger">Unable to load statistics. Please try again later.</p>
    }

    <div class="row mt-4 justify-content-center">
        <div class="col-md-3 quick-links">
            <a href="@Url.Action("Courses", "Student", new { userId = ViewBag.UserId })" class="btn btn-primary">
                <i class="fas fa-book"></i> View Courses
            </a>
        </div>
        <div class="col-md-3 quick-links">
            <a href="@Url.Action("Index", "Student", new { userId = ViewBag.UserId })" class="btn btn-success">
                <i class="fas fa-chart-pie"></i> View Reports
            </a>
        </div>
    </div>
</div>



