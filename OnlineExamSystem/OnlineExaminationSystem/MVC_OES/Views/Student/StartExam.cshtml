@model MVC_OES.Models.Student.StartExamModel

@{
    ViewBag.Title = "Start Exam";
    Layout = "~/Views/Shared/_ExamLayout.cshtml";
    var totalQuestions = Model.questions.Count;
}

@if (Model == null || !Model.questions.Any())
{
    <p class="text-danger">No questions available for this exam.</p>
}
else
{
    <div class="container mt-4">
        <h2>@("Exam - Level " + Model.level_number)</h2>
        <div class="d-flex justify-content-between mb-3">
            <div>
                <strong>Question:</strong> <span id="currentQuestionNumber">1</span> / @totalQuestions
            </div>
            <div>
                <strong>Time Left:</strong> <span id="timer">@Model.duration:00</span> minutes
            </div>
        </div>

        <div class="card shadow p-3 mb-3">
            <h5 id="questionText">@Model.questions[0].QuestionText</h5>
            <div class="mt-3" id="optionsContainer">
                <div class="form-check">
                    <input type="radio" name="option" class="form-check-input" value="A" id="optionA">
                    <label class="form-check-label" id="labelA">@Model.questions[0].OptionA</label>
                </div>
                <div class="form-check">
                    <input type="radio" name="option" class="form-check-input" value="B" id="optionB">
                    <label class="form-check-label" id="labelB">@Model.questions[0].OptionB</label>
                </div>
                <div class="form-check">
                    <input type="radio" name="option" class="form-check-input" value="C" id="optionC">
                    <label class="form-check-label" id="labelC">@Model.questions[0].OptionC</label>
                </div>
                <div class="form-check">
                    <input type="radio" name="option" class="form-check-input" value="D" id="optionD">
                    <label class="form-check-label" id="labelD">@Model.questions[0].OptionD</label>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <strong>Jump to Question:</strong>
            @for (int i = 0; i < totalQuestions; i++)
            {
                <button class="btn btn-outline-primary btn-sm m-1 questionBtn" data-index="@i">
                    @(i + 1)
                </button>
            }
        </div>

        <div class="d-flex justify-content-between">
            <button class="btn btn-secondary" id="prevBtn">Previous</button>
            <button class="btn btn-secondary" id="nextBtn">Next</button>
            <button class="btn btn-success" id="submitBtn">Submit Exam</button>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script>

        var questions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.questions));
        var attemptId = @Model.attempt_id;
        var userId =@((int)Session["UserId"]);
        var courseId = @Model.course_id;
        var levelNumber = @Model.level_number;

        var currentIndex = 0;
        var totalQuestions = questions.length;
        var duration = @Model.duration * 60;
        var answers = {};

        var timerElement = document.getElementById("timer");
        var timer = setInterval(function () {
            var minutes = Math.floor(duration / 60);
            var seconds = duration % 60;
            timerElement.innerText = minutes + ":" + (seconds < 10 ? "0" + seconds : seconds);
            if (duration <= 0) {
                clearInterval(timer);
                alert("Time's up! Submitting exam...");
                submitExam();
            }
            duration--;
        }, 1000);

        function loadQuestion(index) {
            currentIndex = index;
            document.getElementById("currentQuestionNumber").innerText = index + 1;
            document.getElementById("questionText").innerText = questions[index].QuestionText;
            document.getElementById("labelA").innerText = questions[index].OptionA;
            document.getElementById("labelB").innerText = questions[index].OptionB;
            document.getElementById("labelC").innerText = questions[index].OptionC;
            document.getElementById("labelD").innerText = questions[index].OptionD;

            document.querySelectorAll("input[name='option']").forEach(r => r.checked = false);
            if (answers[questions[index].QuestionId]) {
                document.querySelector(`input[value='${answers[questions[index].QuestionId]}']`).checked = true;
            }
        }

        document.querySelectorAll("input[name='option']").forEach(radio => {
            radio.addEventListener("change", function () {
                answers[questions[currentIndex].QuestionId] = this.value;
            });
        });

        document.getElementById("prevBtn").addEventListener("click", function () {
            if (currentIndex > 0) loadQuestion(currentIndex - 1);
        });

        document.getElementById("nextBtn").addEventListener("click", function () {
            if (currentIndex < totalQuestions - 1) loadQuestion(currentIndex + 1);
        });

        document.querySelectorAll(".questionBtn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                loadQuestion(parseInt(btn.dataset.index));
            });
        });

        document.getElementById("submitBtn").addEventListener("click", function () {
            submitExam();
        });

        function submitExam() {
            var payload = {
                attemptId: attemptId,
                userId: userId,
                courseId: courseId,
                levelNumber: levelNumber,
                timeTaken: Math.ceil((@Model.duration * 60 - duration) / 60),
                answers: []
            };

            questions.forEach(q => {
                payload.answers.push({
                    questionId: q.QuestionId,
                    selectedOption: answers[q.QuestionId] || null
                });
            });

            $.ajax({
                url: '/Student/SubmitExam',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (report) {
                    window.location.href = '/Student/ReportFromSubmit?reportJson=' + encodeURIComponent(JSON.stringify(report));
                },
                error: function (xhr) {
                    alert("Error submitting exam: " + xhr.responseText);
                }
            });
        }

        loadQuestion(0);
    </script>
    <script>
        document.addEventListener('contextmenu', event => event.preventDefault());
        document.addEventListener('copy', event => event.preventDefault());
        document.addEventListener('cut', event => event.preventDefault());
        document.addEventListener('paste', event => event.preventDefault());
        document.addEventListener('selectstart', event => event.preventDefault());
        document.addEventListener("keydown", function (e) {
            if (e.keyCode === 44) { 
                alert("Screenshots are not allowed!");
            }
        });
    </script>
    <script>
        document.onkeydown = function (e) {
            if (e.keyCode === 123) {
                return false;
            }
            if (e.ctrlKey && (e.keyCode === 85 || e.keyCode === 73 || e.keyCode === 67 || e.keyCode === 86 || e.keyCode === 88)) {
                return false;
            }
        };
    </script>                 
}

