@model MVC_OES.Models.Student.ExamReportViewModel

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <div class="card-header text-white text-center py-3" style="background: linear-gradient(90deg, #007bff, #00c6ff); border-radius: 0.5rem;">
            <h2>Exam Report</h2>
        </div>

        <div class="card-body mt-3">
            <ul class="list-group mb-4">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Total Questions
                    <span class="badge bg-primary rounded-pill">@Model.totalQuestions</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Total Marks
                    <span class="badge bg-warning text-dark rounded-pill">@Model.totalMarks</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Correct Answers
                    <span class="badge bg-success rounded-pill">@Model.correctAnswers</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Score
                    <span class="badge bg-info text-dark rounded-pill">@Model.score</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Result
                    <span class="badge @(Model.isPassed ? "bg-success" : "bg-danger") rounded-pill">
                        @(Model.isPassed ? "Passed" : "Failed")
                    </span>
                </li>
            </ul>

            <div class="text-center mt-4">
                @if (Model.isPassed)
                {
                    if (!Model.isLastLevel)
                    {
                        <a href="@Url.Action("Instructions", "Student", new { courseId = Model.courseId, levelnumber = Model.nextLevel })" class="btn btn-primary btn-lg">
                            Next Level
                        </a>
                    }
                    else
                    {
                        <p class="mb-3 fw-bold">🎉 Congratulations! You completed the course.</p>
                        <a href="@Url.Action("Courses", "Student", new { userId = (int)Session["UserId"] })" class="btn btn-primary btn-lg">Back to Courses</a>
                    }
                }
                else
                {
                    <a href="@Url.Action("Courses", "Student", new { userId = (int)Session["UserId"] })" class="btn btn-danger btn-lg">Back to Courses</a>
                }
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f5f7fa;
    }

    .list-group-item {
        font-size: 1.1rem;
    }

    .btn-lg {
        font-size: 1.2rem;
        padding: 0.75rem 1.5rem;
    }
</style>
