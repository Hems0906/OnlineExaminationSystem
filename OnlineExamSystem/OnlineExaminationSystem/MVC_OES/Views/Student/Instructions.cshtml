@model MVC_OES.Models.Student.InstructionModel

@{
    Layout = "~/Views/Shared/_ExamLayout.cshtml";
    ViewBag.Title = "Exam Instructions";
}

@if (Model == null)
{
    <p class="text-danger text-center mt-4">No instructions available.</p>
}
else
{
    <div class="container mt-5">
        <div class="card shadow-lg p-0 border-0">
            <div class="card-header text-white text-center py-4" style="background: linear-gradient(90deg, #007bff, #00c6ff); border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem;">
                <h2>Instructions</h2>
                <h5>@Model.course_name - Level @Model.level_number (@Model.level_name)</h5>
            </div>

            <div class="card-body p-4">
                <ul class="list-group mb-4">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <i class="fas fa-question-circle me-2 text-primary"></i>
                        Total Questions
                        <span class="badge bg-primary rounded-pill">@Model.tot_ques</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <i class="fas fa-clock me-2 text-warning"></i>
                        Duration
                        <span class="badge bg-warning text-dark rounded-pill">@Model.duration minutes</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <i class="fas fa-check-circle me-2 text-success"></i>
                        Passing Marks
                        <span class="badge bg-success rounded-pill">@Model.passing_marks</span>
                    </li>
                    <li class="list-group-item">
                        <i class="fas fa-exclamation-triangle me-2 text-danger"></i>
                        Once started, the exam cannot be paused or stopped.
                    </li>
                    <li class="list-group-item">
                        <i class="fas fa-exclamation-triangle me-2 text-danger"></i>
                        Do not refresh or leave the page during the exam.
                    </li>
                </ul>

                <div class="text-center">
                    <a href="@Url.Action("StartExam", "Student", new { courseId = Model.course_id,userId = (int)Session["UserId"], levelNumber = Model.level_number })"
                       class="btn btn-success btn-lg shadow-sm">
                        <i class="fas fa-play me-2"></i> Start Exam
                    </a>
                </div>
            </div>
        </div>
    </div>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f5f7fa;
        }

        .list-group-item i {
            font-size: 1.2rem;
        }

        .card-body ul.list-group li {
            margin-bottom: 10px;
        }

        .btn-lg {
            font-size: 1.2rem;
            padding: 0.75rem 1.5rem;
        }
    </style>
}
