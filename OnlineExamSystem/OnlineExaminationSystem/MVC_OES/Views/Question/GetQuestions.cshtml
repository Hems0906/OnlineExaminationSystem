@model List<MVC_OES.Models.Questions.QuestionModel>

@{
    ViewBag.Title = "Manage Questions";
    int courseId = ViewBag.CourseId;
    int levelNumber = ViewBag.LevelNumber;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5f7fa;
    }

    .question-card {
        background: #fff;
        padding: 20px;
        margin-bottom: 15px;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .question-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        }

    .question-header {
        font-weight: 600;
        margin-bottom: 10px;
    }

    .options span {
        display: block;
        margin-bottom: 5px;
    }

    .toggle-switch {
        width: 50px;
        height: 25px;
        position: relative;
        display: inline-block;
    }

        .toggle-switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 25px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 21px;
            width: 21px;
            left: 2px;
            bottom: 2px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #007bff;
    }

        input:checked + .slider:before {
            transform: translateX(25px);
        }
</style>

<div class="container mt-4">
    <h2 class="mb-3">Manage Questions — Course @courseId | Level @levelNumber</h2>

    <div class="mb-3">
        <a href="@Url.Action("UploadQuestions", "Question", new { courseId = courseId, levelNumber = levelNumber })" class="btn btn-success">
            <i class="fas fa-upload"></i> Upload Questions
        </a>
        <a href="@Url.Action("AddQuestion", "Question", new { courseId = courseId, levelNumber = levelNumber })" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Manually
        </a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        foreach (var q in Model)
        {
            <div class="question-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="question-header">Q: @q.QuestionText</div>
                    <label class="toggle-switch">
                        <input type="checkbox" class="toggle-question-status" data-id="@q.QuestionId" @(q.Status ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="options mt-2">
                    <span><strong>A:</strong> @q.OptionA</span>
                    <span><strong>B:</strong> @q.OptionB</span>
                    <span><strong>C:</strong> @q.OptionC</span>
                    <span><strong>D:</strong> @q.OptionD</span>
                    <span><strong>Answer:</strong> @q.Answer | <strong>Marks:</strong> @q.Marks</span>
                </div>
                <div class="mt-3">
                    <a href="@Url.Action("EditQuestion", "Question", new { questionId = q.QuestionId, courseId = q.CourseId, levelNumber = q.LevelNumber })" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">No questions found for this level.</div>
    }

    <a href="@Url.Action("Levels", "Admin", new { courseId = @courseId })" class="btn btn-warning btn-sm mt-3">
        <i class="fas fa-arrow-left"></i> Back to Levels
    </a>
</div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.toggle-question-status').change(function () {
                var questionId = $(this).data('id');
                var checkbox = $(this);

                $.ajax({
                    url: '@Url.Action("ToggleStatus", "Question")/' + questionId,
                    type: 'POST',
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                        } else {
                            alert(res.message);
                            checkbox.prop('checked', !checkbox.prop('checked'));
                        }
                    },
                    error: function () {
                        alert('Error toggling question status.');
                        checkbox.prop('checked', !checkbox.prop('checked'));
                    }
                });
            });
        });
    </script>
}
