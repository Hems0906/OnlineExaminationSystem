@model IEnumerable<MVC_OES.Models.Questions.QuestionModel>

@{
    ViewBag.Title = "Manage Questions";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f5f7fa;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-header h2 {
        color: #007bff;
        font-weight: 700;
    }

    .add-btn {
        font-weight: bold;
    }

    .table-container {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }

    .table thead {
        background-color: #007bff;
        color: #fff;
    }

    .table tbody tr:hover {
        background-color: #f1faff;
    }

    .form-check-input:checked {
        background-color: #007bff;
        border-color: #007bff;
    }

    .edit-btn {
        font-size: 0.9rem;
    }
</style>

<div class="container mt-4">
    <div class="page-header">
        <h2><i class="fas fa-question-circle"></i> Manage Questions</h2>
    </div>

    <div class="table-container">
        @if (Model != null && Model.Any())
        {
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Level</th>
                        <th>Question</th>
                        <th>A</th>
                        <th>B</th>
                        <th>C</th>
                        <th>D</th>
                        <th>Status</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td>@q.CourseName</td>
                            <td>@q.LevelName</td>
                            <td>@q.QuestionText</td>
                            <td>@q.OptionA</td>
                            <td>@q.OptionB</td>
                            <td>@q.OptionC</td>
                            <td>@q.OptionD</td>
                            <td class="text-center">
                                <div class="form-check form-switch">
                                    <input class="form-check-input toggle-question-status" type="checkbox" data-id="@q.QuestionId" @(q.Status ? "checked" : "") />
                                </div>
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("EditQuestion", "Question", new { id = q.QuestionId })" class="btn btn-warning btn-sm edit-btn">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info text-center">
                No questions found. Please add new questions.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.toggle-question-status').change(function () {
                var questionId = $(this).data('id');
                var checkbox = $(this);

                $.ajax({
                    url: '@Url.Action("ToggleStatus", "Question")/' + questionId,
                    type: 'POST',
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                        } else {
                            alert(res.message);
                            checkbox.prop('checked', !checkbox.prop('checked'));
                        }
                    },
                    error: function () {
                        alert('Error toggling question status.');
                        checkbox.prop('checked', !checkbox.prop('checked'));
                    }
                });
            });
        });
    </script>
}
