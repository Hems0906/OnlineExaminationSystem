@model MVC_OES.Models.Questions.UploadQuestionModel
@{
    ViewBag.Title = "Upload Questions";
    int courseId = ViewBag.CourseId;
    int levelNumber = ViewBag.LevelNumber;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="card shadow-sm p-4">
        <h2 class="mb-3">Upload Questions — Course @courseId | Level @levelNumber</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        @using (Html.BeginForm("UploadQuestions", "Question", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                @Html.LabelFor(m => m.ExcelFile, "Select Excel File (.xlsx)", htmlAttributes: new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.ExcelFile, new { type = "file", accept = ".xlsx", @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ExcelFile, "", new { @class = "text-danger" })
                <small class="text-muted">Ensure the Excel file follows the required format.</small>
            </div>

            <input type="hidden" name="courseId" value="@courseId" />
            <input type="hidden" name="levelNumber" value="@levelNumber" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-upload"></i> Upload
                </button>
                <a href="@Url.Action("GetQuestions", "Question", new { courseId = courseId, levelNumber = levelNumber })" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Questions
                </a>
            </div>
        }
    </div>
</div>
